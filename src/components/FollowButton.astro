---
import { tracked } from "@/lib/analytics";
import Icon from "@/components/Icon.astro";

interface Props {
	/** Which feed — drives the icon and the analytics placement */
	feed: "substack" | "wordpress";
	label: string;
	href: string;
}

const { feed, label, href } = Astro.props;
---

<a
	href={href}
	target="_blank"
	rel="noopener noreferrer"
	class="btn pressable"
	{...tracked("subscribe_clicked", { channel: feed, placement: "follow" })}
>
	<Icon name={feed} size={13} />
	{label}
</a>

---
import { tracked } from "@/lib/analytics";
import GitHubActivity from "@/components/GitHubActivity.astro";
import GoodreadsActivity from "@/components/GoodreadsActivity.astro";
import { siteConfig } from "@/data/config";

interface GroupLink {
	label: string;
	href: string;
	count: number;
	active: boolean;
}

interface Props {
	/** Extra grouping panel above About (section pages only) */
	grouping?: {
		title: string;
		links: GroupLink[];
	};
}

const { grouping } = Astro.props;
---

<aside class="sidebar flex flex-col gap-4">
	{
		grouping && (
			<div class="panel">
				<div class="ph">
					<h2>{grouping.title}</h2>
				</div>
				<div class="pb">
					{grouping.links.map((link) => (
						<a
							class:list={[
								"group-row flex items-baseline justify-between py-1 text-ui hover:text-accent transition-colors",
								link.active && "text-accent",
							]}
							href={link.href}
						>
							<span class="truncate">{link.label}</span>
							<span class="shrink-0 font-mono text-meta text-text-faint">{link.count}</span>
						</a>
					))}
				</div>
			</div>
		)
	}

	<div class="panel" style="--order: 5">
		<div class="ph">
			<h2>Goodreads</h2>
			<span class="ph-links">
				<a
					href={siteConfig.goodreads.profileUrl}
					target="_blank"
					rel="noopener noreferrer"
					{...tracked("goodreads_clicked", { target: "profile" })}
				>{siteConfig.goodreads.handle} →</a>
			</span>
		</div>
		<div class="pb">
			<GoodreadsActivity />
		</div>
	</div>

	<div class="panel" style="--order: 6">
		<div class="ph">
			<h2>GitHub Activity</h2>
			<span class="ph-links">
				<a
					href={siteConfig.socials.find((s) => s.key === "github")?.href}
					target="_blank"
					rel="noopener noreferrer"
					{...tracked("github_clicked", { target: "profile" })}
				>@eeshansrivastava89 →</a>
			</span>
		</div>
		<div class="pb">
			<GitHubActivity />
		</div>
	</div>
</aside>
---
import { siteConfig } from "@/data/config";
import { brandIcons } from "@/data/icons";

interface Props {
	/** Which feed's subscribe box to render — matches `feed` in siteConfig.subscribe */
	feed: "substack" | "wordpress";
}

const { feed } = Astro.props;
const config = siteConfig.subscribe.find((s) => s.feed === feed);
if (!config) {
	throw new Error(`No subscribe config for feed "${feed}" in src/data/config.ts`);
}

const icon = feed === "substack" ? brandIcons.substack : null;
const placement = feed === "substack" ? "subscribe_box_substack" : "subscribe_box_wordpress";
---

<div class="sub-box">
	<div class="sub-copy">
		<span class="sub-kicker">{config.kicker}</span>
		<span class="sub-tagline">{config.tagline}</span>
	</div>
	<a
		href={config.href}
		target="_blank"
		rel="noopener noreferrer"
		class="sub-button"
		data-ph-event="subscription_cta_clicked"
		data-ph-placement={placement}
		data-ph-target-type={feed}
	>
		{icon && (
			<svg viewBox={icon.viewBox || "0 0 24 24"} fill="currentColor" aria-hidden="true" width="14" height="14"><path d={icon.path} /></svg>
		)}
		Follow
	</a>
</div>

<style>
	/* Quiet restyle: hairline border, inset tint, mono kicker — matches the panel system */
	.sub-box {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		padding: 14px 16px;
		border-radius: 10px;
		border: 1px solid var(--color-line);
		background: var(--color-bg-raised);
	}

	.sub-copy {
		display: flex;
		flex-direction: column;
		gap: 2px;
		min-width: 0;
	}

	.sub-kicker {
		font-family: var(--font-mono);
		font-size: 13px;
		font-weight: 500;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		white-space: nowrap;
		color: var(--color-text-soft);
	}

	.sub-tagline {
		font-size: 14px;
		color: var(--color-text-soft);
	}

	.sub-button {
		display: inline-flex;
		align-items: center;
		gap: 7px;
		flex-shrink: 0;
		padding: 6px 13px;
		border-radius: 3px;
		border: 1px solid var(--color-line-strong);
		background: var(--color-bg);
		color: var(--color-text);
		font-family: var(--font-mono);
		font-size: 13px;
		text-decoration: none;
		transition: border-color 150ms ease, color 150ms ease, transform 150ms cubic-bezier(0.23, 1, 0.32, 1);
	}

	.sub-button:active {
		transform: scale(0.97);
	}

	.sub-button:hover {
		border-color: var(--color-accent);
		color: var(--color-accent);
		text-decoration: none;
	}

	@media (max-width: 520px) {
		.sub-box {
			align-items: flex-start;
			flex-direction: column;
		}
	}
</style>
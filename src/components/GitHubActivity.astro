---
import { getGitHubData } from "@/lib/github";
import { siteConfig } from "@/data/config";

const githubData = await getGitHubData();

const {
	followers,
	publicRepos,
	totalStars,
	weeks: allWeeks,
	recentActivity,
	activityTotals,
} = githubData;

const weeks = allWeeks.slice(-siteConfig.homepage.github.weeks);
// 26 weeks ≈ 6 months; derived so changing the window keeps the label honest
const windowMonths = Math.round(weeks.length / (52 / 12));
const sixMonthContributions = weeks
	.flatMap((week) => week.contributionDays)
	.reduce((sum, day) => sum + day.contributionCount, 0);

const commitActivity = recentActivity.filter((item) => item.category === "commit");
const commitRepoCount = new Set(commitActivity.map((item) => item.repo)).size;
// Top repositories by commits, ranked explicitly — never by API order
const repoRows = [...commitActivity]
	.sort((a, b) => (b.commits ?? 0) - (a.commits ?? 0))
	.slice(0, siteConfig.homepage.github.repos);

// Use displayed weeks only for threshold calculation so the visible heatmap
// has meaningful color variation. Using all-time data compresses visible days.
const allDays = weeks.flatMap((week) => week.contributionDays);
const maxDayCount = Math.max(...allDays.map((day) => day.contributionCount), 1);

// GitHub-style 4-level scale using quartiles of the displayed range
const sortedCounts = allDays.map((d) => d.contributionCount).filter((c) => c > 0).sort((a, b) => a - b);
const p25 = sortedCounts.length > 0 ? sortedCounts[Math.floor(sortedCounts.length * 0.25)] : maxDayCount * 0.25;
const p50 = sortedCounts.length > 0 ? sortedCounts[Math.floor(sortedCounts.length * 0.5)] : maxDayCount * 0.5;
const p75 = sortedCounts.length > 0 ? sortedCounts[Math.floor(sortedCounts.length * 0.75)] : maxDayCount * 0.75;

const levelFor = (count: number): number => {
	if (count === 0) return 0;
	if (count <= p25) return 1;
	if (count <= p50) return 2;
	if (count <= p75) return 3;
	return 4;
};
---

<div>
	<div class="text-meta text-text-faint mb-2.5">
		<b class="font-mono font-medium text-text">{followers.toLocaleString()}</b> followers · <b class="font-mono font-medium text-text">{totalStars.toLocaleString()}</b> stars · <b class="font-mono font-medium text-text">{publicRepos.toLocaleString()}</b> repos · <b class="font-mono font-medium text-text">{sixMonthContributions.toLocaleString()}</b> contributions in the last {windowMonths} months
	</div>
	<div class="gh-contrib-grid mb-1" style={`--weeks: ${weeks.length};`}>
		{weeks.map((week) => (
			<div class="gh-contrib-week">
				{week.contributionDays.map((day) => (
					<div
						class:list={["gh-contrib-day", `l${levelFor(day.contributionCount)}`]}
						data-tip={`${day.date}: ${day.contributionCount} contribution${day.contributionCount === 1 ? "" : "s"}`}
					/>
				))}
			</div>
		))}
	</div>
	<div class="gh-repos">
		<h3>{activityTotals.commits.toLocaleString()} commits in {commitRepoCount} {commitRepoCount === 1 ? "repository" : "repositories"}</h3>
		{repoRows.map((row) => (
			<a
				href={row.url}
				class="gh-row"
				target="_blank"
				rel="noopener noreferrer"
				data-ph-event="github_activity_clicked"
				data-ph-target-type="commit"
			>
				<span>{row.repo}</span>
				<b>{row.message}</b>
			</a>
		))}
	</div>
</div>

<style>
	/* Contribution heatmap — scoped CSS for grid and hover behavior */
	.gh-contrib-grid {
		display: grid;
		grid-template-columns: repeat(var(--weeks), minmax(0, 1fr));
		gap: 3px;
		overflow: visible;
	}

	.gh-contrib-week {
		display: grid;
		grid-template-rows: repeat(7, minmax(0, 1fr));
		gap: 3px;
		min-width: 0;
		overflow: visible;
	}

	.gh-contrib-day {
		position: relative;
		width: 100%;
		aspect-ratio: 1 / 1;
		border-radius: 2px;
		border: 1px solid var(--color-line);
		background: var(--color-heat-0);
		cursor: default;
		transition:
			transform 160ms cubic-bezier(0.22, 1, 0.36, 1),
			border-color 160ms cubic-bezier(0.22, 1, 0.36, 1),
			box-shadow 160ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.gh-contrib-day:hover {
		z-index: 2;
		transform: translateY(-3px) scale(1.45);
		border-color: color-mix(in oklab, var(--color-accent) 70%, var(--color-line));
		box-shadow:
			0 7px 14px color-mix(in oklab, var(--color-text) 15%, transparent),
			0 0 0 1px color-mix(in oklab, var(--color-bg) 80%, transparent);
	}

	/* Tooltip — only laid out on hover, so the offscreen hidden boxes never
	   contribute to scrollable overflow (horizontal scrolling on mobile) */
	.gh-contrib-day::after {
		content: none;
		position: absolute;
		bottom: calc(100% + 6px);
		left: 50%;
		transform: translateX(-50%) scale(0.9);
		transform-origin: 50% 100%;
		padding: 2px 6px;
		border-radius: 4px;
		font-size: 13px;
		font-family: var(--font-mono);
		white-space: nowrap;
		color: var(--color-bg);
		background: var(--color-text);
		pointer-events: none;
		z-index: 20;
	}
	.gh-contrib-day::before {
		content: none;
		position: absolute;
		bottom: calc(100% + 2px);
		left: 50%;
		transform: translateX(-50%);
		border: 4px solid transparent;
		border-top-color: var(--color-text);
		pointer-events: none;
		z-index: 10;
	}
	.gh-contrib-day:hover::after {
		content: attr(data-tip);
	}
	.gh-contrib-day:hover::before {
		content: "";
	}

	@media (prefers-reduced-motion: reduce) {
		.gh-contrib-day {
			transition: none;
		}
		.gh-contrib-day:hover {
			transform: none;
		}
	}

	/* Green contribution levels — the sole accent, green in both themes */
	.gh-contrib-day.l1 { background: var(--color-heat-1); border-color: transparent; }
	.gh-contrib-day.l2 { background: var(--color-heat-2); border-color: transparent; }
	.gh-contrib-day.l3 { background: var(--color-heat-3); border-color: transparent; }
	.gh-contrib-day.l4 { background: var(--color-heat-4); border-color: transparent; }
</style>

<script>
	const grid = document.querySelector(".gh-contrib-grid");
	if (grid) {
		let lastShown = 0;
		grid.addEventListener("pointerover", (e) => {
			const day = (e.target as HTMLElement).closest(".gh-contrib-day");
			if (!day) return;
			const now = performance.now();
			if (now - lastShown < 800) {
				grid.setAttribute("data-scrubbing", "");
			} else {
				grid.removeAttribute("data-scrubbing");
			}
			lastShown = now;
		});
	}
</script>
---
import { tracked } from "@/lib/analytics";
import FollowButton from "@/components/FollowButton.astro";
import { SUBSTACK_SUBSCRIBE_URL } from "@/lib/substack";
import { WORDPRESS_FOLLOW_URL } from "@/lib/wordpress";
import { formatDate } from "@/data/content";
import type { FeedGroup, GroupLink } from "@/data/feed-groups";

interface Props {
	/** Page title, e.g. "Technical Writing" */
	title: string;
	/** Subscribe config per feed */
	feed: "substack" | "wordpress";
	/** Feed rows bucketed by year — one group when a year filter is active */
	groups: FeedGroup[];
	/** Year panel links */
	yearLinks: GroupLink[];
	/** Secondary grouping: tags or categories */
	secondTitle: string;
	secondLinks: GroupLink[];
	/** "n posts" label reflecting the active filter */
	filterLabel: string;
}

const {
	title,
	feed,
	groups,
	yearLinks,
	secondTitle,
	secondLinks,
	filterLabel,
} = Astro.props;
---

<div class="layout">
	<aside class="sidebar sidebar--divided flex flex-col gap-4">
		<div class="panel sidebar-section" style="--order: 90">
			<div class="ph">
				<h2>Years</h2>
			</div>
			<div class="pb">
				{yearLinks.map((link) => (
					<a
						class:list={[
							"group-row flex items-baseline py-1 text-ui transition-colors hover:text-accent",
							link.active && "text-accent",
						]}
						href={link.href}
					>
						<span class="truncate">{link.label} <span class="font-mono text-meta text-text-faint">({link.count})</span></span>
					</a>
				))}
			</div>
		</div>

		<div class="panel sidebar-section" style="--order: 91">
			<div class="ph">
				<h2>{secondTitle}</h2>
			</div>
			<div class="pb">
				{secondLinks.map((link) => (
					<a
						class:list={[
							"group-row flex items-baseline py-1 text-ui transition-colors hover:text-accent",
							link.active && "text-accent",
						]}
						href={link.href}
					>
						<span class="truncate">{link.label} <span class="font-mono text-meta text-text-faint">({link.count})</span></span>
					</a>
				))}
			</div>
		</div>

		<div class="follow-row sidebar-section" style="--order: 92">
			{feed === "substack" ? (
				<FollowButton feed="substack" href={SUBSTACK_SUBSCRIBE_URL} label="Follow on Substack" />
			) : (
				<FollowButton feed="wordpress" href={WORDPRESS_FOLLOW_URL} label="Follow on WordPress" />
			)}
		</div>
	</aside>

	<div class="main flex min-w-0 flex-col gap-4">
		<header style="--order: 10">
			<h1 class="page-title">{title}</h1>
			<p class="mt-1 text-meta text-text-faint">{filterLabel}</p>
		</header>
		<div class="panel feed" style="--order: 11">
			<div class="pb">
				{groups.map((group) => (
					<section class="feed-year">
						<h2 class="feed-year-label">{group.year}</h2>
						{group.posts.map((post) => (
							<a class="item" href={post.href} {...tracked("content_clicked", { content_type: feed === "substack" ? "writing" : "blog", placement: "feed", slug: post.href.split("/").pop() })}>
								<span class="d">{formatDate(post.date)}</span>
								<span class="t">{post.title}</span>
							</a>
						))}
					</section>
				))}
			</div>
		</div>
	</div>
</div>

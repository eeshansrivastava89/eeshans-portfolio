---
import SubscribeLink from "@/components/SubscribeLink.astro";
import { formatDate } from "@/data/content";
import type { FeedGroup, GroupLink } from "@/data/feed-groups";

interface Props {
	/** Page title, e.g. "Technical Writing" */
	title: string;
	/** Subscribe config per feed */
	feed: "substack" | "wordpress";
	/** Feed rows bucketed by year — one group when a year filter is active */
	groups: FeedGroup[];
	/** Year panel links */
	yearLinks: GroupLink[];
	/** Secondary grouping: tags or categories */
	secondTitle: string;
	secondLinks: GroupLink[];
	/** "n posts" label reflecting the active filter */
	filterLabel: string;
}

const {
	title,
	feed,
	groups,
	yearLinks,
	secondTitle,
	secondLinks,
	filterLabel,
} = Astro.props;
---

<div class="layout">
	<aside class="sidebar flex flex-col gap-4">
		<div class="panel" style="--order: 90">
			<div class="ph">
				<h2>Years</h2>
			</div>
			<div class="pb">
				{yearLinks.map((link) => (
					<a
						class:list={[
							"group-row flex items-baseline justify-between py-1 text-ui transition-colors hover:text-accent",
							link.active && "text-accent",
						]}
						href={link.href}
					>
						<span class="truncate">{link.label}</span>
						<span class="shrink-0 font-mono text-meta text-text-faint">{link.count}</span>
					</a>
				))}
			</div>
		</div>

		<div class="panel" style="--order: 91">
			<div class="ph">
				<h2>{secondTitle}</h2>
			</div>
			<div class="pb">
				{secondLinks.map((link) => (
					<a
						class:list={[
							"group-row flex items-baseline justify-between py-1 text-ui transition-colors hover:text-accent",
							link.active && "text-accent",
						]}
						href={link.href}
					>
						<span class="truncate">{link.label}</span>
						<span class="shrink-0 font-mono text-meta text-text-faint">{link.count}</span>
					</a>
				))}
			</div>
		</div>

		<SubscribeLink feed={feed} />
	</aside>

	<div class="main flex min-w-0 flex-col gap-4">
		<header style="--order: 10">
			<h1 class="page-title">{title}</h1>
			<p class="mt-1 text-meta text-text-faint">{filterLabel}</p>
		</header>
		<div class="panel feed" style="--order: 11">
			<div class="pb">
				{groups.map((group) => (
					<section class="feed-year">
						<h2 class="feed-year-label">{group.year}</h2>
						{group.posts.map((post) => (
							<a class="item" href={post.href} data-ph-event={feed === "substack" ? "writing_item_clicked" : "blog_item_clicked"} data-ph-placement={`${feed}_feed`} data-ph-target-type={feed === "substack" ? "writing_item" : "blog_item"}>
								<span class="d">{formatDate(post.date)}</span>
								<span class="t">{post.title}</span>
							</a>
						))}
					</section>
				))}
			</div>
		</div>
	</div>
</div>

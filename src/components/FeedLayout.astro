---
import SubscribeLink from "@/components/SubscribeLink.astro";
import { formatDate } from "@/data/content";
import type { PostEntry } from "@/data/content";

interface GroupLink {
	label: string;
	href: string;
	count: number;
	active: boolean;
}

interface Props {
	/** Panel title, e.g. "Writing" */
	title: string;
	/** Pill variant + subscribe URL config per feed */
	feed: "substack" | "wordpress";
	/** Primary feed rows: slug, date, title */
	posts: { slug: string; date: Date; title: string; href: string }[];
	/** Year panel links */
	yearLinks: GroupLink[];
	/** Secondary grouping: tags or categories */
	secondTitle: string;
	secondLinks: GroupLink[];
	/** "n posts" label reflecting the active filter */
	filterLabel: string;
}

const {
	title,
	feed,
	posts,
	yearLinks,
	secondTitle,
	secondLinks,
	filterLabel,
} = Astro.props;
---

<div class="layout">
	<aside class="sidebar flex flex-col gap-4">
		<div class="panel">
			<div class="ph">
				<h2>Years</h2>
			</div>
			<div class="pb">
				{yearLinks.map((link) => (
					<a
						class:list={[
							"group-row meta flex items-baseline justify-between py-1 text-[13px] transition-colors hover:text-accent",
							link.active && "text-accent",
						]}
						href={link.href}
					>
						<span class="truncate">{link.label}</span>
						<span class="shrink-0 text-text-faint">{link.count}</span>
					</a>
				))}
			</div>
		</div>

		<div class="panel">
			<div class="ph">
				<h2>{secondTitle}</h2>
			</div>
			<div class="pb">
				{secondLinks.map((link) => (
					<a
						class:list={[
							"group-row meta flex items-baseline justify-between py-1 text-[13px] transition-colors hover:text-accent",
							link.active && "text-accent",
						]}
						href={link.href}
					>
						<span class="truncate">{link.label}</span>
						<span class="shrink-0 text-text-faint">{link.count}</span>
					</a>
				))}
			</div>
		</div>

		<SubscribeLink feed={feed} />
	</aside>

	<div class="main flex min-w-0 flex-col gap-4">
		<div class="panel">
			<div class="ph">
				<h2>{title}</h2>
				<span class="more">{filterLabel}</span>
			</div>
			<div class="pb feed">
				{posts.map((post) => (
					<a class="item" href={post.href} data-ph-event={feed === "substack" ? "writing_item_clicked" : "blog_item_clicked"} data-ph-placement={`${feed}_feed`} data-ph-target-type={feed === "substack" ? "writing_item" : "blog_item"}>
						<span class="d">{formatDate(post.date)}</span>
						<span class="t">{post.title}</span>
					</a>
				))}
			</div>
		</div>
	</div>
</div>
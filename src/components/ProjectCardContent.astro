---
interface Props {
	title: string;
	hook: string;
	liveUrl?: string;
	repoUrl?: string;
	videoWebm?: string;
	videoMp4?: string;
	videoPoster?: string;
}

const { title, hook, liveUrl, repoUrl, videoWebm, videoMp4, videoPoster } =
	Astro.props;

const hasVideo = Boolean(videoWebm || videoMp4);
---

<article class="flex flex-col">
	{
		hasVideo && videoPoster && (
			<button
				type="button"
				class="group/poster relative block w-full aspect-video rounded-lg border border-border overflow-hidden cursor-pointer bg-muted mb-3.5 p-0"
				data-demo
				data-title={title}
				data-webm={videoWebm}
				data-mp4={videoMp4}
				aria-label={`Play ${title} demo video`}
			>
				<img
					src={videoPoster}
					alt={`${title} screenshot`}
					loading="lazy"
					class="w-full h-full object-cover transition-transform duration-300 group-hover/poster:scale-[1.02]"
				/>
				<span class="absolute inset-0 flex items-center justify-center bg-foreground/5 opacity-0 transition-opacity duration-200 group-hover/poster:opacity-100">
					<span class="w-12 h-12 rounded-full bg-foreground/80 flex items-center justify-center shadow-lg">
						<svg class="w-5 h-5 fill-background ml-0.5" viewBox="0 0 24 24">
							<polygon points="5,3 19,12 5,21" />
						</svg>
					</span>
				</span>
			</button>
		)
	}

	<h3
		class="font-[family-name:var(--font-display)] text-[1.3rem] leading-snug mb-1.5"
	>
		<a
			href={liveUrl || repoUrl || "#"}
			class="text-foreground hover:text-link transition-colors"
			target="_blank"
			rel="noopener noreferrer"
		>
			{title}
		</a>
	</h3>

	<p class="text-sm text-foreground/80 leading-relaxed line-clamp-3 mb-3">
		{hook}
	</p>

	<div class="mt-auto flex items-center gap-4 text-sm">
		{
			liveUrl && (
				<a
					href={liveUrl}
					class="inline-flex items-center gap-1 text-link hover:text-link-2 transition-colors"
					target="_blank"
					rel="noopener noreferrer"
				>
					<svg
						class="w-3 h-3"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
					>
						<path d="M15 3h6v6" />
						<path d="M10 14 21 3" />
						<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
					</svg>
					Live
				</a>
			)
		}
		{
			repoUrl && (
				<a
					href={repoUrl}
					class="inline-flex items-center gap-1 text-link hover:text-link-2 transition-colors"
					target="_blank"
					rel="noopener noreferrer"
				>
					<svg class="w-3 h-3" viewBox="0 0 24 24" fill="currentColor">
						<path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.37 1.23-3.21-.12-.3-.54-1.515.12-3.15 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.635.24 2.85.12 3.15.765.84 1.23 1.905 1.23 3.21 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
					</svg>
					Source
				</a>
			)
		}
		{
			hasVideo && (
				<button
					type="button"
					class="inline-flex items-center gap-1 text-link hover:text-link-2 transition-colors cursor-pointer"
					data-demo
					data-title={title}
					data-webm={videoWebm}
					data-mp4={videoMp4}
				>
					<svg class="w-3 h-3" viewBox="0 0 24 24" fill="currentColor">
						<polygon points="5,3 19,12 5,21" />
					</svg>
					Demo
				</button>
			)
		}
	</div>
</article>

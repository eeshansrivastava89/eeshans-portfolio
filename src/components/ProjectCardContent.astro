---
interface Props {
	title: string;
	hook: string;
	liveUrl?: string;
	repoUrl?: string;
	videoWebm?: string;
	videoMp4?: string;
	videoPoster?: string;
	/** Dashboard grid: compact card without poster, per locked design */
	compact?: boolean;
}

const {
	title,
	hook,
	liveUrl,
	repoUrl,
	videoWebm,
	videoMp4,
	videoPoster,
	compact = false,
} = Astro.props;

const hasVideo = Boolean(videoWebm || videoMp4);
const repoName = repoUrl ? repoUrl.split("/").at(-1) : undefined;
---

<article class="flex min-w-0 flex-col p-3.5">
	{
		!compact && hasVideo && videoPoster && (
			<button
				type="button"
				class="group/poster relative block w-full aspect-video rounded-lg border border-line overflow-hidden cursor-pointer bg-bg-inset mb-3.5 p-0 transition-transform duration-150 ease-[cubic-bezier(0.23,1,0.32,1)] active:scale-[0.98]"
				data-demo
				data-title={title}
				data-webm={videoWebm}
				data-mp4={videoMp4}
				aria-label={`Play ${title} demo video`}
			>
				<img
					src={videoPoster}
					alt={`${title} preview`}
					loading="lazy"
					decoding="async"
					class="h-full w-full object-cover"
				/>
				<span class="absolute inset-0 flex items-center justify-center bg-text/5 opacity-0 transition-opacity duration-200 group-hover/poster:opacity-100">
					<span class="flex h-10 w-10 items-center justify-center rounded-full bg-text/85 text-bg">▶</span>
				</span>
			</button>
		)
	}

	<h3 class="text-[16px] font-bold tracking-[-0.01em] leading-snug">
		<a href={liveUrl ?? repoUrl} class="hover:text-accent transition-colors">{title}</a>
	</h3>

	<p class="mt-1 flex-1 text-[14px] text-text-soft leading-[1.55] line-clamp-3">
		{hook}
	</p>

	<div class="mt-3 flex flex-wrap gap-3">
		{
			liveUrl && (
				<a
					href={liveUrl}
					class="meta text-[13px] text-tech transition-colors hover:text-link-2"
					target="_blank"
					rel="noopener noreferrer"
					data-ph-event="project_link_clicked"
					data-ph-target-type="live_site"
					data-ph-placement="project_actions"
				>
					{liveUrl.replace(/^https?:\/\//, "").split("/")[0]}
				</a>
			)
		}
		{
			hasVideo && (
				<button
					type="button"
					class="meta cursor-pointer text-[13px] text-tech transition-colors hover:text-link-2"
					data-demo
					data-title={title}
					data-webm={videoWebm}
					data-mp4={videoMp4}
				>
					Demo
				</button>
			)
		}
		{
			repoName && (
				<span class="meta ml-auto max-w-full text-[13px] text-text-faint">{repoName}</span>
			)
		}
	</div>
</article>
---
interface Props {
	title: string;
	hook: string;
	liveUrl?: string;
	repoUrl?: string;
	videoWebm?: string;
	videoMp4?: string;
	videoPoster?: string;
	/** Dashboard grid: compact card without poster, per locked design */
	compact?: boolean;
}

const {
	title,
	hook,
	liveUrl,
	repoUrl,
	videoWebm,
	videoMp4,
	videoPoster,
	compact = false,
} = Astro.props;

const hasVideo = Boolean(videoWebm || videoMp4);
const primaryHref = liveUrl ?? repoUrl;
---

<article class="project-card">
	{
		!compact && hasVideo && videoPoster && (
			<button
				type="button"
				class="group/poster relative block w-full aspect-video rounded-lg border border-line overflow-hidden cursor-pointer bg-bg-inset mb-3.5 p-0 transition-transform duration-150 ease-[cubic-bezier(0.23,1,0.32,1)] active:scale-[0.98]"
				data-demo
				data-title={title}
				data-webm={videoWebm}
				data-mp4={videoMp4}
				aria-label={`Play ${title} demo video`}
			>
				<img
					src={videoPoster}
					alt={`${title} preview`}
					loading="lazy"
					decoding="async"
					class="h-full w-full object-cover"
				/>
				<span class="absolute inset-0 flex items-center justify-center bg-text/5 opacity-0 transition-opacity duration-200 group-hover/poster:opacity-100">
					<span class="flex h-10 w-10 items-center justify-center rounded-full bg-text/85 text-bg">▶</span>
				</span>
			</button>
		)
	}

	<h3 class="text-reading font-bold tracking-[-0.01em] leading-snug">
		<a href={primaryHref} class="hover:text-accent transition-colors">{title}</a>
	</h3>

	<p class="project-hook">{hook}</p>

	<div class="project-actions">
		{
			hasVideo && (
				<button
					type="button"
					class="btn pressable"
					data-demo
					data-title={title}
					data-webm={videoWebm}
					data-mp4={videoMp4}
					data-ph-event="project_link_clicked"
					data-ph-target-type="demo_video"
					data-ph-placement="project_actions"
				>
					▶ Demo
				</button>
			)
		}
		{
			repoUrl && (
				<a
					href={repoUrl}
					class="btn"
					target="_blank"
					rel="noopener noreferrer"
					data-ph-event="project_link_clicked"
					data-ph-target-type="github_repo"
					data-ph-placement="project_actions"
				>
					Code
				</a>
			)
		}
	</div>
</article>

---
import Icon from "@/components/Icon.astro";

interface Props {
	title: string;
	hook: string;
	liveUrl?: string;
	repoUrl?: string;
	videoWebm?: string;
	videoMp4?: string;
	videoPoster?: string;
	/** Dashboard grid: compact card without poster, per locked design */
	compact?: boolean;
}

const {
	title,
	hook,
	liveUrl,
	repoUrl,
	videoWebm,
	videoMp4,
	videoPoster,
	compact = false,
} = Astro.props;

const hasVideo = Boolean(videoWebm || videoMp4);
---

<article class="flex min-w-0 flex-col p-3.5">
	{
		!compact && hasVideo && videoPoster && (
			<button
				type="button"
				class="group/poster relative block w-full aspect-video rounded-lg border border-line overflow-hidden cursor-pointer bg-bg-inset mb-3.5 p-0 transition-transform duration-150 ease-[cubic-bezier(0.23,1,0.32,1)] active:scale-[0.98]"
				data-demo
				data-title={title}
				data-webm={videoWebm}
				data-mp4={videoMp4}
				aria-label={`Play ${title} demo video`}
			>
				<img
					src={videoPoster}
					alt={`${title} preview`}
					loading="lazy"
					decoding="async"
					class="h-full w-full object-cover"
				/>
				<span class="absolute inset-0 flex items-center justify-center bg-text/5 opacity-0 transition-opacity duration-200 group-hover/poster:opacity-100">
					<span class="flex h-10 w-10 items-center justify-center rounded-full bg-text/85 text-bg">▶</span>
				</span>
			</button>
		)
	}

	<h3 class="text-reading font-bold tracking-[-0.01em] leading-snug">
		<a href={liveUrl ?? repoUrl} class="hover:text-accent transition-colors">{title}</a>
	</h3>

	<p class="mt-1 text-ui text-text-soft leading-[1.5] line-clamp-3">
		{hook}
	</p>

	<div class="mt-auto pt-3">
		{
			liveUrl && (
				<a
					href={liveUrl}
					class="block text-meta text-text-soft transition-colors hover:text-accent"
					target="_blank"
					rel="noopener noreferrer"
					data-ph-event="project_link_clicked"
					data-ph-target-type="live_site"
					data-ph-placement="project_actions"
				>
					{liveUrl.replace(/^https?:\/\//, "").split("/")[0]}
				</a>
			)
		}
		<div class="mt-2 flex items-center gap-1">
			{
				hasVideo && (
					<button
						type="button"
						class="pressable inline-flex h-10 w-10 items-center justify-center rounded-md text-text-soft transition-colors hover:text-accent"
						data-demo
						data-title={title}
						data-webm={videoWebm}
						data-mp4={videoMp4}
						aria-label={`Play ${title} demo video`}
					>
						<Icon name="play" size={15} />
					</button>
				)
			}
			{
				repoUrl && (
					<a
						href={repoUrl}
						class="pressable inline-flex h-10 w-10 items-center justify-center rounded-md text-text-soft transition-colors hover:text-accent"
						target="_blank"
						rel="noopener noreferrer"
						aria-label={`${title} GitHub repository`}
						data-ph-event="project_link_clicked"
						data-ph-target-type="github_repo"
						data-ph-placement="project_actions"
					>
						<Icon name="github" size={15} />
					</a>
				)
			}
		</div>
	</div>
</article>
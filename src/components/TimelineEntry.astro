---
interface Props {
	timespan: string;
	title: string;
	organization: string;
	detail?: string;
	logo?: string;
}

const { timespan, title, organization, detail, logo } = Astro.props;
const isSvg = logo?.endsWith(".svg");
---

<div class="flex items-start gap-4 border-b border-line py-5 last:border-b-0">
	{logo && (
		<img src={`/logos/${logo}`} alt="" class:list={["logo-img", { "logo-img--svg": isSvg }]} />
	)}
	<div class="min-w-0">
		<div class="font-mono mb-0.5 text-meta text-text-faint">{timespan}</div>
		<div class="text-reading text-text">{title} <span class="font-semibold text-text-soft">· {organization}</span></div>
		{detail && <div class="mt-0.5 text-reading text-text-soft">{detail}</div>}
	</div>
</div>

<style>
	.logo-img {
		width: 5rem;
		height: 5rem;
		flex-shrink: 0;
		object-fit: contain;
		border-radius: 0.5rem;
		border: 1px solid var(--color-line);
		background: #fff;
		padding: 0.375rem;
	}
</style>
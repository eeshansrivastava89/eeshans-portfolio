---
import { siteConfig } from "@/data/config";
import { brandIcons } from "@/data/icons";
import Icon from "@/components/Icon.astro";

interface Props {
	/** Which feed — matches `feed` in siteConfig.subscribe */
	feed: "substack" | "wordpress";
}

const { feed } = Astro.props;
const config = siteConfig.subscribe.find((s) => s.feed === feed);
if (!config) {
	throw new Error(`No subscribe config for feed "${feed}" in src/data/config.ts`);
}
---

<a
	href={config.href}
	target="_blank"
	rel="noopener noreferrer"
	class="panel pressable flex items-center gap-3 px-4 py-3 transition-colors hover:border-accent"
	data-ph-event="subscription_cta_clicked"
	data-ph-placement={`${feed}_sidebar_link`}
	data-ph-target-type={feed}
>
	<Icon name={feed} className="h-4 w-4 shrink-0 text-text-soft" />
	<span class="text-ui font-semibold">Follow {config.kicker}</span>
	<span class="ml-auto text-meta text-text-faint">→</span>
</a>
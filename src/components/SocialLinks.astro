---
import { siteConfig } from "@/data/config";
import Icon from "@/components/Icon.astro";

/**
 * Social links row — used on homepage and about page.
 * URLs and labels come from config.ts. Icons are brand SVGs
 * keyed by `key` in the socials array.
 */
interface Props {
	class?: string;
	/** Narrow sidebar variant: one link per row */
	vertical?: boolean;
}

const { class: className = "", vertical = false } = Astro.props;

const socials = siteConfig.socials;
---

<div class:list={[vertical ? "flex flex-col items-start gap-2.5" : "flex flex-wrap items-center gap-5", className]}>
	{socials.map((social) => (
		<a href={social.href} class="text-ui text-text-soft transition-colors hover:text-text inline-flex items-center gap-1.5" target="_blank" rel="noopener noreferrer" data-ph-event="social_link_clicked" data-ph-target-type={social.key} data-ph-placement="social_links">
			<Icon name={social.key} className="w-4 h-4" />
			{social.label}
		</a>
	))}
</div>
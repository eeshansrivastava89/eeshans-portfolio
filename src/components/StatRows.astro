---
import { getVisiblePosts, getBlogPosts, getProjects } from "@/data/content";

// Shared at-a-glance rows: live counts, never hardcoded. Used by the homepage
// About panel and the About page sidebar.
const [posts, blogPosts, projects] = await Promise.all([
	getVisiblePosts(),
	getBlogPosts(),
	getProjects(),
]);
const writingSince = Math.min(
	...blogPosts.map((p) => p.data.createdAt.getUTCFullYear()),
	2008,
);
---

<div class="mt-2.5">
	<div class="flex justify-between py-1.5 border-b border-line text-meta">
		<span class="text-text-soft">writing since</span><b class="font-mono font-medium text-text">{writingSince}</b>
	</div>
	<div class="flex justify-between py-1.5 border-b border-line text-meta">
		<span class="text-text-soft">personal posts</span><b class="font-mono font-medium text-text">{blogPosts.length}</b>
	</div>
	<div class="flex justify-between py-1.5 border-b border-line text-meta">
		<span class="text-text-soft">technical essays</span><b class="font-mono font-medium text-text">{posts.length}</b>
	</div>
	<div class="flex justify-between py-1.5 text-meta">
		<span class="text-text-soft">projects shipped</span><b class="font-mono font-medium text-text">{projects.length}</b>
	</div>
</div>

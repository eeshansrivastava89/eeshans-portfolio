---
import type { PostHeading } from "@/data/content";

interface Props {
	title: string;
	/** Post headings extracted from the rendered body */
	headings: PostHeading[];
}

const { title, headings } = Astro.props;
const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

{tocHeadings.length > 0 && (
	<details class="toc panel" style="--order: 4" open>
		<summary class="ph toc-summary">
			<span class="toc-title">Contents</span>
		</summary>
		<div class="pb">
			<a class="toc-root block py-1 text-ui font-semibold text-text transition-colors hover:text-accent" href="#top">
				{title}
			</a>
			<ul class="toc-list">
				{tocHeadings.map((h) => (
					<li class:list={["toc-item", `toc-item-d${h.depth}`]}>
						<a class="block py-1 text-ui text-text-soft transition-colors hover:text-accent" href={`#${h.slug}`}>
							{h.text}
						</a>
					</li>
				))}
			</ul>
		</div>
	</details>
)}

<script is:inline>
	// B1: on phones the contents panel starts collapsed between the title and
	// the body; on desktop it is always open and its header is inert.
	(() => {
		const tocs = document.querySelectorAll("details.toc");
		if (!tocs.length) return;
		const desktop = window.matchMedia("(min-width: 961px)");
		tocs.forEach((toc) => {
			toc.open = desktop.matches;
		});
		desktop.addEventListener("change", () => {
			if (desktop.matches) tocs.forEach((toc) => (toc.open = true));
		});
	})();
</script>

<script is:inline>
	// Contents highlights the section currently in view.
	// Deferred: the script sits above the article body it observes.
	const initToc = () => {
		const toc = document.querySelector("details.toc");
		if (!toc) return;
		const links = [...toc.querySelectorAll('a[href^="#"]')].filter((a) => !a.classList.contains("toc-root"));
		const targets = links
			.map((a) => ({ link: a, el: document.getElementById(decodeURIComponent(a.getAttribute("href")).slice(1)) }))
			.filter((pair) => pair.el);
		if (!targets.length) return;
		const setActive = (el) => {
			for (const { link, el: target } of targets) {
				if (target === el) link.setAttribute("aria-current", "true");
				else link.removeAttribute("aria-current");
			}
		};
		const observer = new IntersectionObserver(
			(entries) => {
				const visible = entries
					.filter((entry) => entry.isIntersecting)
					.sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
				if (visible[0]) setActive(visible[0].target);
			},
			{ rootMargin: "-96px 0px -65% 0px", threshold: 0 },
		);
		targets.forEach(({ el }) => observer.observe(el));
	};
	if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", initToc, { once: true });
	else initToc();
</script>

<style>
	/* Collapsed-by-default disclosure on mobile; the header keeps panel chrome */
	.toc-summary {
		cursor: pointer;
		list-style: none;
	}
	.toc-summary::-webkit-details-marker {
		display: none;
	}
	.toc-summary::after {
		content: "▾";
		margin-left: auto;
		color: var(--color-text-faint);
		transition: transform 150ms ease;
	}
	.toc[open] > .toc-summary::after {
		transform: rotate(180deg);
	}
	@media (min-width: 961px) {
		.toc-summary {
			cursor: default;
			pointer-events: none;
		}
		.toc-summary::after {
			content: none;
		}
	}
	/* Nested bullets: h2 children under the root title, h3 nested one level deeper */
	.toc-list {
		list-style: disc;
		padding-left: 18px;
		margin: 0;
	}
	.toc-item-d2 {
		list-style-type: disc;
	}
	.toc-item-d3 {
		list-style-type: circle;
		padding-left: 16px;
	}
</style>

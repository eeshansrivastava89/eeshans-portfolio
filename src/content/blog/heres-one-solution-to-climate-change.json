p=\"height\" content=\"226\"> <img decoding=\"async\" class=\"\" data-attachment-id=\"1386\" data-orig-file=\"https://blog.eeshans.com/wp-content/uploads/2016/03/climate-influences-people6.png\" data-orig-size=\"661,301\" data-comments-opened=\"1\" data-image-title=\"Climate-Influences-People6\" data-image-description=\"\" data-medium-file=\"https://i0.wp.com/blog.eeshans.com/wp-content/uploads/2016/03/climate-influences-people6.png?fit=300%2C137&#038;ssl=1\" data-large-file=\"https://i0.wp.com/blog.eeshans.com/wp-content/uploads/2016/03/climate-influences-people6.png?fit=661%2C301&#038;ssl=1\" src=\"https://i0.wp.com/blog.eeshans.com/wp-content/uploads/2016/03/climate-influences-people6.png?w=496&#038;h=226&#038;ssl=1\" width=\"496\" height=\"226\" loading=\"lazy\" data-original-width=\"496\" data-original-height=\"226\" itemprop=\"http://schema.org/image\" title=\"Climate-Influences-People6\" alt=\"Climate-Influences-People6\" style=\"width: 496px; height: 226px;\" /> </a> </div> </div> <!-- close group --> </div> <!-- close row --> <div class=\"gallery-row\" style=\"width: 500px; height: 297px;\" data-original-width=\"500\" data-original-height=\"297\" > <div class=\"gallery-group images-1\" style=\"width: 304px; height: 297px;\" data-original-width=\"304\" data-original-height=\"297\" > <div class=\"tiled-gallery-item tiled-gallery-item-large\" itemprop=\"associatedMedia\" itemscope itemtype=\"http://schema.org/ImageObject\"> <a href=\"https://blog.eeshans.com/2016/03/29/heres-one-solution-to-climate-change/climate-influences-people2/\" border=\"0\" itemprop=\"url\"> <meta itemprop=\"width\" content=\"300\"> <meta itemprop=\"height\" content=\"293\"> <img decoding=\"async\" class=\"\" data-attachment-id=\"1387\" data-orig-file=\"https://blog.eeshans.com/wp-content/uploads/2016/03/climate-influences-people2.png\" data-orig-size=\"321,313\" data-comments-opened=\"1\" data-image-title=\"Climate-Influences-People2\" data-image-description=\"\" data-medium-file=\"https://i0.wp.com/blog.eeshans.com/wp-content/uploads/2016/03/climate-influences-people2.png?fit=300%2C293&#038;ssl=1\" data-large-file=\"https://i0.wp.com/blog.eeshans.com/wp-content/uploads/2016/03/climate-influences-people2.png?fit=321%2C313&#038;ssl=1\" src=\"https://i0.wp.com/blog.eeshans.com/wp-content/uploads/2016/03/climate-influences-people2.png?w=300&#038;h=293&#038;ssl=1\" width=\"300\" height=\"293\" loading=\"lazy\" data-original-width=\"300\" data-original-height=\"293\" itemprop=\"http://schema.org/image\" title=\"Climate-Influences-People2\" alt=\"Climate-Influences-People2\" style=\"width: 300px; height: 293px;\" /> </a> </div> </div> <!-- close group --> <div class=\"gallery-group images-1\" style=\"width: 196px; height: 297px;\" data-original-width=\"196\" data-original-height=\"297\" > <div class=\"tiled-gallery-item tiled-gallery-item-small\" itemprop=\"associatedMedia\" itemscope itemtype=\"http://schema.org/ImageObject\"> <a href=\"https://blog.eeshans.com/2016/03/29/heres-one-solution-to-climate-change/climate-influences-people7/\" border=\"0\" itemprop=\"url\"> <meta itemprop=\"width\" content=\"192\"> <meta itemprop=\"height\" content=\"293\"> <img decoding=\"async\" class=\"\" data-attachment-id=\"1384\" data-orig-file=\"https://blog.eeshans.com/wp-content/uploads/2016/03/climate-influences-people7.png\" data-orig-size=\"401,611\" data-comments-opened=\"1\" data-image-title=\"Climate-Influences-People7\" data-image-description=\"\" data-medium-file=\"https://i0.wp.com/blog.eeshans.com/wp-content/uploads/2016/03/climate-influences-people7.png?fit=197%2C300&#038;ssl=1\" data-large-file=\"https://i0.wp.com/blog.eeshans.com/wp-content/uploads/2016/03/climate-influences-people7.png?fit=401%2C611&#038;ssl=1\" src=\"https://i0.wp.com/blog.eeshans.com/wp-content/uploads/2016/03/climate-influences-people7.png?w=192&#038;h=293&#038;ssl=1\" width=\"192\" height=\"293\" loading=\"lazy\" data-original-width=\"192\" data-original-height=\"293\" itemprop=\"http://schema.org/image\" title=\"Climate-Influences-People7\" alt=\"Climate-Influences-People7\" style=\"width: 192px; height: 293px;\" /> </a> </div> </div> <!-- close group --> </div> <!-- close row --> <div class=\"gallery-row\" style=\"width: 500px; height: 475px;\" data-original-width=\"500\" data-original-height=\"475\" > <div class=\"gallery-group images-1\" style=\"width: 500px; height: 475px;\" data-original-width=\"500\" data-original-height=\"475\" > <div class=\"tiled-gallery-item tiled-gallery-item-large\" itemprop=\"associatedMedia\" itemscope itemtype=\"http://schema.org/ImageObject\"> <a href=\"https://blog.eeshans.com/2016/03/29/heres-one-solution-to-climate-change/climate-influences-people5/\" border=\"0\" itemprop=\"url\"> <meta itemprop=\"width\" content=\"496\"> <meta itemprop=\"height\" content=\"471\"> <img decoding=\"async\" class=\"\" data-attachment-id=\"1390\" data-orig-file=\"https://blog.eeshans.com/wp-content/uploads/2016/03/climate-influences-people5.png\" data-orig-size=\"391,371\" data-comments-opened=\"1\" data-image-title=\"Climate-Influences-People5\" data-image-description=\"\" data-medium-file=\"https://i0.wp.com/blog.eeshans.com/wp-content/uploads/2016/03/climate-influences-people5.png?fit=300%2C285&#038;ssl=1\" data-large-file=\"https://i0.wp.com/blog.eeshans.com/wp-content/uploads/2016/03/climate-influences-people5.png?fit=391%2C371&#038;ssl=1\" src=\"https://i0.wp.com/blog.eeshans.com/wp-content/uploads/2016/03/climate-influences-people5.png?w=496&#038;h=471&#038;ssl=1\" width=\"496\" height=\"471\" loading=\"lazy\" data-original-width=\"496\" data-original-height=\"471\" itemprop=\"http://schema.org/image\" title=\"Climate-Influences-People5\" alt=\"Climate-Influences-People5\" style=\"width: 496px; height: 471px;\" /> </a> </div> </div> <!-- close group --> </div> <!-- close row --> </div></p>\n<p>Now these were the facts, here&#8217;s the solution:</p>\n<p><span title=\"Edited\">There is a group of volunteers who are hitting the right chord when it comes to climate change. They are trying to mobilize people and the government into action akin to the scale at which the WWII mobilization happened. That was done to protect the country, and this again will be done to protect the country, and the world!</span></p>\n<p><span title=\"Edited\">I highly recommend visiting this page to find out how they intend to mobilize people and economies to actually do something about the greatest human-made threat to humanity. Check our their website to learn more and take action: <a href=\"http://goo.gl/IAP8LE\" target=\"_blank\">http://goo.gl/IAP8LE</a>.</span><span title=\"Edited\"><br />\n</span></p>\n<blockquote><p><span style=\"text-decoration:underline;\"><strong>Mission</strong></span>: <em><strong>The Climate Mobilization</strong></em> is a new, volunteer-powered organization. Our mission is to protect civilization and the natural world from catastrophic climate disruption. We are dedicated to <a href=\"http://www.theclimatemobilization.org/transformative?utm_source=eeshan_srivastava\">living in climate truth,</a> and believe that working to solve the climate crisis is everyone&#8217;s responsibility.</p></blockquote>\n<p><img data-recalc-dims=\"1\" loading=\"lazy\" decoding=\"async\" data-attachment-id=\"1353\" data-permalink=\"https://blog.eeshans.com/2016/03/29/heres-one-solution-to-climate-change/image/\" data-orig-file=\"https://i0.wp.com/blog.eeshans.com/wp-content/uploads/2016/03/image.png?fit=562%2C509&amp;ssl=1\" data-orig-size=\"562,509\" data-comments-opened=\"1\" data-image-title=\"image\" data-image-description=\"\" data-image-caption=\"\" data-large-file=\"https://i0.wp.com/blog.eeshans.com/wp-content/uploads/2016/03/image.png?fit=562%2C509&amp;ssl=1\" class=\"alignnone size-full wp-image-1353\" src=\"https://i0.wp.com/blog.eeshans.com/wp-content/uploads/2016/03/image.png?resize=562%2C509&#038;ssl=1\" alt=\"image.png\" width=\"562\" height=\"509\" /></p>\n<p><a href=\"http://goo.gl/IAP8LE\">TAKE ACTION!</a></p>\n",

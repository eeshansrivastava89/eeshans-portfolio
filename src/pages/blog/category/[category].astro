---
import BaseLayout from "@/layouts/Base.astro";
import FeedLayout from "@/components/FeedLayout.astro";
import { getBlogPosts } from "@/data/content";
import { groupByYear, groupLinks, yearLinks } from "@/data/feed-groups";

export async function getStaticPaths() {
	const allPosts = await getBlogPosts();
	const slugs = new Set(allPosts.flatMap((p) => p.data.categories.map((c) => c.slug)));
	return [...slugs].map((slug) => ({ params: { category: slug } }));
}

const requestedCatSlug = Astro.params.category!;
const allPosts = await getBlogPosts();
const catName = allPosts.flatMap((p) => p.data.categories).find((c) => c.slug === requestedCatSlug)?.name;
if (!catName) {
	throw new Error(`Unknown category slug "${requestedCatSlug}" on /blog/category`);
}

// Category view spans all years (the category panel is the filter)
const posts = allPosts.filter((p) => p.data.categories.some((c) => c.slug === requestedCatSlug));
const groups = groupByYear(posts, (post) => `/blog/${post.id}`);
const years = yearLinks(allPosts, "/blog");
const categories = groupLinks(allPosts, (post) => post.data.categories, "/blog/category", requestedCatSlug);
---

<BaseLayout
	title={`Personal Blog — ${catName}`}
	description={`${posts.length} personal blog posts by Eeshan Srivastava in “${catName}”.`}
	activePage="/blog"
>
	<FeedLayout
		title="Personal Blog"
		feed="wordpress"
		groups={groups}
		yearLinks={years}
		secondTitle="Categories"
		secondLinks={categories}
		filterLabel={`${catName} · ${posts.length} posts`}
	/>
</BaseLayout>

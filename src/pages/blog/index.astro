---
import BaseLayout from "@/layouts/Base.astro";
import FeedLayout from "@/components/FeedLayout.astro";
import { getBlogPosts } from "@/data/content";
import { groupByYear, groupLinks, yearLinks } from "@/data/feed-groups";

// One archive shape for both feeds: every post, grouped by year.
// Year and category pages remain filters on the same grouping.

const allPosts = await getBlogPosts();
const groups = groupByYear(allPosts, (post) => `/blog/${post.id}`);
const years = yearLinks(allPosts, "/blog");
const categories = groupLinks(allPosts, (post) => post.data.categories, "/blog/category");
---

<BaseLayout
	title="Personal Blog"
	description={`Eeshan Srivastava's personal blog: ${allPosts.length} posts of essays, poems, book reviews, and drawings since ${years.at(-1)!.label}.`}
	activePage="/blog"
>
	<FeedLayout
		title="Personal Blog"
		feed="wordpress"
		groups={groups}
		yearLinks={years}
		secondTitle="Categories"
		secondLinks={categories}
		filterLabel={`${allPosts.length} posts · all years`}
	/>
</BaseLayout>

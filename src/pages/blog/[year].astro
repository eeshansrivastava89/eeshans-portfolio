---
import BaseLayout from "@/layouts/Base.astro";
import FeedLayout from "@/components/FeedLayout.astro";
import { getBlogPosts } from "@/data/content";

const CURRENT_YEAR = new Date().getFullYear();

export async function getStaticPaths() {
	const allPosts = await getBlogPosts();
	const years = [...new Set(allPosts.map((p) => p.data.createdAt.getFullYear()))].sort((a, b) => b - a);
	return years.map((year) => ({ params: { year: year.toString() } }));
}

const allPosts = await getBlogPosts();
const requestedYear = Astro.params.year!;
const year = Number(requestedYear);

const byYear = new Map<string, number>();
for (const post of allPosts) {
	const y = post.data.createdAt.getFullYear().toString();
	byYear.set(y, (byYear.get(y) ?? 0) + 1);
}
const yearLinks = [...byYear.entries()]
	.sort((a, b) => Number(b[0]) - Number(a[0]))
	.map(([y, count]) => ({
		label: y,
		href: `/blog/${y}`,
		count,
		active: y === requestedYear,
	}));

const catCounts = new Map<string, { name: string; count: number }>();
for (const post of allPosts) {
	for (const cat of post.data.categories) {
		const entry = catCounts.get(cat.slug) ?? { name: cat.name, count: 0 };
		entry.count += 1;
		catCounts.set(cat.slug, entry);
	}
}
const categoryLinks = [...catCounts.entries()]
	.sort((a, b) => b[1].count - a[1].count)
	.map(([slug, { name, count }]) => ({ label: name, href: `/blog/category/${slug}`, count, active: false }));

const posts = allPosts
	.filter((p) => p.data.createdAt.getFullYear() === year)
	.map((p) => ({ slug: p.id, date: p.data.createdAt, title: p.data.title, href: `/blog/${p.id}` }));
---

<BaseLayout title={`Personal Blog — ${requestedYear}`} activePage="/blog">
	<FeedLayout
		title="Personal Blog"
		feed="wordpress"
		posts={posts}
		yearLinks={yearLinks}
		secondTitle="Categories"
		secondLinks={categoryLinks}
		filterLabel={`${requestedYear} · ${posts.length} posts`}
	/>
</BaseLayout>
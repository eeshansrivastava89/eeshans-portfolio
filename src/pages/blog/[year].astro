---
import BaseLayout from "@/layouts/Base.astro";
import FeedLayout from "@/components/FeedLayout.astro";
import { getBlogPosts } from "@/data/content";
import { groupByYear, groupLinks, yearLinks } from "@/data/feed-groups";

export async function getStaticPaths() {
	const allPosts = await getBlogPosts();
	const years = new Set(allPosts.map((p) => p.data.createdAt.getUTCFullYear()));
	return [...years].sort((a, b) => b - a).map((year) => ({ params: { year: year.toString() } }));
}

const allPosts = await getBlogPosts();
const requestedYear = Astro.params.year!;
const year = Number(requestedYear);

const posts = allPosts.filter((p) => p.data.createdAt.getUTCFullYear() === year);
const groups = groupByYear(posts, (post) => `/blog/${post.id}`);
const years = yearLinks(allPosts, "/blog", requestedYear);
const categories = groupLinks(allPosts, (post) => post.data.categories, "/blog/category");
---

<BaseLayout
	title={`Personal Blog — ${requestedYear}`}
	description={`${posts.length} personal blog posts by Eeshan Srivastava from ${requestedYear}.`}
	activePage="/blog"
>
	<FeedLayout
		title="Personal Blog"
		feed="wordpress"
		groups={groups}
		yearLinks={years}
		secondTitle="Categories"
		secondLinks={categories}
		filterLabel={`${requestedYear} · ${posts.length} posts`}
	/>
</BaseLayout>

---
import BaseLayout from "@/layouts/Base.astro";
import FeedLayout from "@/components/FeedLayout.astro";
import { getVisiblePosts } from "@/data/content";

const CURRENT_YEAR = new Date().getFullYear();

export async function getStaticPaths() {
	const allPosts = await getVisiblePosts();
	const years = [...new Set(allPosts.map((p) => p.data.createdAt.getFullYear()))].sort((a, b) => b - a);
	return years.map((year) => ({ params: { year: year.toString() } }));
}

const allPosts = await getVisiblePosts();
const requestedYear = Astro.params.year!;
const year = Number(requestedYear);

const byYear = new Map<string, number>();
for (const post of allPosts) {
	const y = post.data.createdAt.getFullYear().toString();
	byYear.set(y, (byYear.get(y) ?? 0) + 1);
}
const yearLinks = [...byYear.entries()]
	.sort((a, b) => Number(b[0]) - Number(a[0]))
	.map(([y, count]) => ({
		label: y,
		href: `/writing/${y}`,
		count,
		active: y === requestedYear,
	}));

const tagCounts = new Map<string, { name: string; count: number }>();
for (const post of allPosts) {
	for (const tag of post.data.tags) {
		const entry = tagCounts.get(tag.slug) ?? { name: tag.name, count: 0 };
		entry.count += 1;
		tagCounts.set(tag.slug, entry);
	}
}
const tagLinks = [...tagCounts.entries()]
	.sort((a, b) => b[1].count - a[1].count)
	.map(([slug, { name, count }]) => ({ label: name, href: `/writing/tag/${slug}`, count, active: false }));

const posts = allPosts
	.filter((p) => p.data.createdAt.getFullYear() === year)
	.map((p) => ({ slug: p.id, date: p.data.createdAt, title: p.data.title, href: `/writing/${p.id}` }));
---

<BaseLayout title={`Technical Writing — ${requestedYear}`} activePage="/writing">
	<FeedLayout
		title="Technical Writing"
		feed="substack"
		posts={posts}
		yearLinks={yearLinks}
		secondTitle="Tags"
		secondLinks={tagLinks}
		filterLabel={`${requestedYear} · ${posts.length} essays`}
	/>
</BaseLayout>
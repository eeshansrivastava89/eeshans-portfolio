---
import BaseLayout from "@/layouts/Base.astro";
import FeedLayout from "@/components/FeedLayout.astro";
import { getVisiblePosts } from "@/data/content";
import { groupByYear, groupLinks, yearLinks } from "@/data/feed-groups";

export async function getStaticPaths() {
	const allPosts = await getVisiblePosts();
	const years = new Set(allPosts.map((p) => p.data.createdAt.getUTCFullYear()));
	return [...years].sort((a, b) => b - a).map((year) => ({ params: { year: year.toString() } }));
}

const allPosts = await getVisiblePosts();
const requestedYear = Astro.params.year!;
const year = Number(requestedYear);

const posts = allPosts.filter((p) => p.data.createdAt.getUTCFullYear() === year);
const groups = groupByYear(posts, (post) => `/writing/${post.id}`);
const years = yearLinks(allPosts, "/writing", requestedYear);
const tags = groupLinks(allPosts, (post) => post.data.tags, "/writing/tag");
---

<BaseLayout
	title={`Technical Writing — ${requestedYear}`}
	description={`${posts.length} technical essays by Eeshan Srivastava from ${requestedYear}.`}
	activePage="/writing"
>
	<FeedLayout
		title="Technical Writing"
		feed="substack"
		groups={groups}
		yearLinks={years}
		secondTitle="Tags"
		secondLinks={tags}
		filterLabel={`${requestedYear} · ${posts.length} essays`}
	/>
</BaseLayout>

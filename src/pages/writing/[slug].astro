---
import BaseLayout from "@/layouts/Base.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import PostSidebar from "@/components/PostSidebar.astro";
import { getVisiblePosts, formatDate, getPostHeadings } from "@/data/content";
import { siteConfig } from "@/data/config";

export async function getStaticPaths() {
	const posts = await getVisiblePosts();
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const substackUrl = post.data.externalUrl ?? siteConfig.subscribe.find((s) => s.feed === "substack")!.href;
const tocHeadings = getPostHeadings(post.data.body ?? "");
---

<BaseLayout title={post.data.title} description={post.data.description} activePage="/writing" canonical={substackUrl} image={post.data.coverImage}>
	<div class="layout">
		<PostSidebar
			feed="substack"
			title={post.data.title}
			metadata={{
				date: post.data.createdAt,
				groups: post.data.tags.map((t) => ({
					name: t.name,
					href: `/writing/tag/${t.slug}`,
				})),
			}}
			headings={tocHeadings}
		/>

		<article class="main min-w-0">
			<Breadcrumb
				crumbs={[
					{ label: "Technical Writing", href: "/writing" },
					{ label: String(post.data.createdAt.getUTCFullYear()), href: `/writing/${post.data.createdAt.getUTCFullYear()}` },
				]}
			/>
			<header class="mb-10" style="--order: 2">
				<h1 id="top" class="page-title mb-3">{post.data.title}</h1>
				<p class="text-meta text-text-faint">
					<span class="font-mono">{formatDate(post.data.createdAt)}</span>
					{" · "}
					<a
						href={substackUrl}
						class="text-accent transition-colors hover:text-accent-2"
						target="_blank"
						rel="noopener noreferrer"
						data-ph-event="substack_article_clicked"
						data-ph-placement="writing_post_header"
					>Originally published on Asymptotic ↗</a>
				</p>
			</header>

			<article class="post-body prose prose-neutral dark:prose-invert" style="--order: 4" set:html={post.data.body} />
		</article>
	</div>
</BaseLayout>
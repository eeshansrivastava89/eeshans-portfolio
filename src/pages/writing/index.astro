---
import BaseLayout from "@/layouts/Base.astro";
import FeedLayout from "@/components/FeedLayout.astro";
import { getVisiblePosts } from "@/data/content";
import { groupByYear, groupLinks, yearLinks } from "@/data/feed-groups";

// Same archive shape as /blog: every essay, grouped by year.

const allPosts = await getVisiblePosts();
const groups = groupByYear(allPosts, (post) => `/writing/${post.id}`);
const years = yearLinks(allPosts, "/writing");
const tags = groupLinks(allPosts, (post) => post.data.tags, "/writing/tag");
---

<BaseLayout
	title="Technical Writing"
	description={`Technical writing by Eeshan Srivastava: ${allPosts.length} essays on local AI, data science, and experimentation.`}
	activePage="/writing"
>
	<FeedLayout
		title="Technical Writing"
		feed="substack"
		groups={groups}
		yearLinks={years}
		secondTitle="Tags"
		secondLinks={tags}
		filterLabel={`${allPosts.length} essays · all years`}
	/>
</BaseLayout>

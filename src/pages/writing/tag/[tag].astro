---
import BaseLayout from "@/layouts/Base.astro";
import FeedLayout from "@/components/FeedLayout.astro";
import { getVisiblePosts } from "@/data/content";
import { groupByYear, groupLinks, yearLinks } from "@/data/feed-groups";

export async function getStaticPaths() {
	const allPosts = await getVisiblePosts();
	const slugs = new Set(allPosts.flatMap((p) => p.data.tags.map((t) => t.slug)));
	return [...slugs].map((slug) => ({ params: { tag: slug } }));
}

const requestedTagSlug = Astro.params.tag!;
const allPosts = await getVisiblePosts();
const tagName = allPosts.flatMap((p) => p.data.tags).find((t) => t.slug === requestedTagSlug)?.name;
if (!tagName) {
	throw new Error(`Unknown tag slug "${requestedTagSlug}" on /writing/tag`);
}

// Tag view spans all years (the tag panel is the filter, year panel stays navigable)
const posts = allPosts.filter((p) => p.data.tags.some((t) => t.slug === requestedTagSlug));
const groups = groupByYear(posts, (post) => `/writing/${post.id}`);
const years = yearLinks(allPosts, "/writing");
const tags = groupLinks(allPosts, (post) => post.data.tags, "/writing/tag", requestedTagSlug);
---

<BaseLayout
	title={`Technical Writing — ${tagName}`}
	description={`${posts.length} technical essays by Eeshan Srivastava tagged “${tagName}”.`}
	activePage="/writing"
>
	<FeedLayout
		title="Technical Writing"
		feed="substack"
		groups={groups}
		yearLinks={years}
		secondTitle="Tags"
		secondLinks={tags}
		filterLabel={`${tagName} · ${posts.length} essays`}
	/>
</BaseLayout>

---
import BaseLayout from "@/layouts/Base.astro";
import ProjectCardContent from "@/components/ProjectCardContent.astro";
import { getProjects } from "@/data/content";

const projects = await getProjects();
---

<BaseLayout
	title="Projects"
	description={`Open-source projects by Eeshan Srivastava: ${projects.map((p) => p.data.title).join(", ")}.`}
	activePage="/projects"
>
	<h1 class="page-title mb-6">Projects</h1>
	<div class="project-grid">
		{projects.map((project) => (
			<ProjectCardContent
				placement="projects_card"
				title={project.data.title}
				hook={project.data.hook}
				liveUrl={project.data.liveUrl}
				repoUrl={project.data.repoUrl}
				videoWebm={project.data.videoWebm}
				videoMp4={project.data.videoMp4}
				videoPoster={project.data.videoPoster}
			/>
		))}
	</div>
</BaseLayout>
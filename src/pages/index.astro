---
import BaseLayout from "@/layouts/Base.astro";
import Sidebar from "@/components/Sidebar.astro";
import ProjectCardContent from "@/components/ProjectCardContent.astro";
import { siteConfig } from "@/data/config";
import { getProjects, getVisiblePosts, getBlogPosts, formatDate } from "@/data/content";
import { SUBSTACK_SUBSCRIBE_URL } from "@/lib/substack";
import { WORDPRESS_FOLLOW_URL } from "@/lib/wordpress";

const projects = await getProjects();
const posts = await getVisiblePosts();
const blogPosts = await getBlogPosts();

const topProjects = projects.slice(0, 4);

// Homepage feeds show the same number of rows in both panels
const HOMEPAGE_FEED_COUNT = 5;
---

<BaseLayout title={siteConfig.title} description={siteConfig.description}>
	<div class="layout">
		<Sidebar />

		<div class="main flex min-w-0 flex-col gap-4">
			<div class="panel" style="--order: 2">
				<div class="ph">
					<h2>Technical Writing</h2>
					<span class="ph-links">
						<a href="/writing">all {posts.length} →</a>
						<a
							href={SUBSTACK_SUBSCRIBE_URL}
							target="_blank"
							rel="noopener noreferrer"
							data-ph-event="subscription_cta_clicked"
							data-ph-placement="writing_panel_header"
							data-ph-target-type="substack"
						>Subscribe on Substack →</a>
					</span>
				</div>
				<div class="pb feed">
					{posts.slice(0, HOMEPAGE_FEED_COUNT).map((post) => (
						<a
							class="item"
							href={`/writing/${post.id}`}
							data-ph-event="writing_item_clicked"
							data-ph-placement="home_writing_feed"
							data-ph-target-type="writing_item"
						>
							<span class="d">{formatDate(post.data.createdAt)}</span>
							<span class="t">{post.data.title}</span>
						</a>
					))}
				</div>
			</div>

			<div class="panel" style="--order: 3">
				<div class="ph">
					<h2>Personal Blog</h2>
					<span class="ph-links">
						<a href="/blog">all {blogPosts.length} →</a>
						<a
							href={WORDPRESS_FOLLOW_URL}
							target="_blank"
							rel="noopener noreferrer"
							data-ph-event="subscription_cta_clicked"
							data-ph-placement="blog_panel_header"
							data-ph-target-type="wordpress"
						>Follow on WordPress →</a>
					</span>
				</div>
				<div class="pb feed">
					{blogPosts.slice(0, HOMEPAGE_FEED_COUNT).map((post) => (
						<a
							class="item"
							href={`/blog/${post.id}`}
							data-ph-event="blog_item_clicked"
							data-ph-placement="home_blog_feed"
							data-ph-target-type="blog_item"
						>
							<span class="d">{formatDate(post.data.createdAt)}</span>
							<span class="t">{post.data.title}</span>
						</a>
					))}
				</div>
			</div>

			<div class="panel" style="--order: 4">
				<div class="ph">
					<h2>Projects</h2>
					<span class="ph-links"><a href="/projects">all →</a></span>
				</div>
				<div class="project-grid p-3 pb-3.5">
					{topProjects.map((project) => (
						<ProjectCardContent
							title={project.data.title}
							hook={project.data.hook}
							liveUrl={project.data.liveUrl}
							repoUrl={project.data.repoUrl}
							videoWebm={project.data.videoWebm}
							videoMp4={project.data.videoMp4}
							videoPoster={project.data.videoPoster}
							compact
						/>
					))}
				</div>
			</div>
		</div>
	</div>
</BaseLayout>
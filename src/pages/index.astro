---
import { tracked } from "@/lib/analytics";
import BaseLayout from "@/layouts/Base.astro";
import Sidebar from "@/components/Sidebar.astro";
import ProjectCardContent from "@/components/ProjectCardContent.astro";
import FollowButton from "@/components/FollowButton.astro";
import { siteConfig } from "@/data/config";
import { getProjects, getVisiblePosts, getBlogPosts, formatDate } from "@/data/content";
import { SUBSTACK_SUBSCRIBE_URL } from "@/lib/substack";
import { WORDPRESS_FOLLOW_URL } from "@/lib/wordpress";

const projects = await getProjects();
const posts = await getVisiblePosts();
const blogPosts = await getBlogPosts();

const topProjects = projects.slice(0, siteConfig.homepage.projectItems);

---

<BaseLayout title={siteConfig.title} description={siteConfig.hero.metaDescription}>
	<section class="hero-band">
		<img class="hero-photo" src="/images/art-profile-eeshan.jpeg" alt="Eeshan Srivastava" width="128" height="128" />
		<div>
			<h1 class="hero-name">{siteConfig.hero.headline}</h1>
			<p class="hero-line">{siteConfig.hero.pitch}</p>
		</div>
	</section>

	<div class="layout">
		<Sidebar />

		<div class="main flex min-w-0 flex-col gap-4">
			<div class="panel" style="--order: 2">
				<div class="ph">
					<h2>Technical Writing</h2>
					<span class="ph-links">
						<a href="/writing">all {posts.length} →</a>
					</span>
				</div>
				<div class="follow-row">
					<FollowButton feed="substack" href={SUBSTACK_SUBSCRIBE_URL} label="Follow on Substack" />
				</div>
				<div class="pb feed">
					{posts.slice(0, siteConfig.homepage.feedItems).map((post, i) => (
						<a
							class:list={["item", i === 0 && "is-new"]}
							href={`/writing/${post.id}`}
							{...tracked("content_clicked", { content_type: "writing", placement: "home_feed", slug: post.id })}
						>
							<span class="d">{formatDate(post.data.createdAt)}</span>
							<span class="t">{post.data.title}{i === 0 && <span class="new-tag">New</span>}</span>
						</a>
					))}
				</div>
			</div>

			<div class="panel" style="--order: 3">
				<div class="ph">
					<h2>Personal Blog</h2>
					<span class="ph-links">
						<a href="/blog">all {blogPosts.length} →</a>
					</span>
				</div>
				<div class="follow-row">
					<FollowButton feed="wordpress" href={WORDPRESS_FOLLOW_URL} label="Follow on WordPress" />
				</div>
				<div class="pb feed">
					{blogPosts.slice(0, siteConfig.homepage.feedItems).map((post, i) => (
						<a
							class:list={["item", i === 0 && "is-new"]}
							href={`/blog/${post.id}`}
							{...tracked("content_clicked", { content_type: "blog", placement: "home_feed", slug: post.id })}
						>
							<span class="d">{formatDate(post.data.createdAt)}</span>
							<span class="t">{post.data.title}{i === 0 && <span class="new-tag">New</span>}</span>
						</a>
					))}
				</div>
			</div>

			<div class="panel" style="--order: 4">
				<div class="ph">
					<h2>Projects</h2>
					<span class="ph-links"><a href="/projects">all →</a></span>
				</div>
				<div class="project-grid">
					{topProjects.map((project) => (
						<ProjectCardContent
							title={project.data.title}
							hook={project.data.hook}
							liveUrl={project.data.liveUrl}
							repoUrl={project.data.repoUrl}
							videoWebm={project.data.videoWebm}
							videoMp4={project.data.videoMp4}
							videoPoster={project.data.videoPoster}
							compact
						/>
					))}
				</div>
			</div>
		</div>
	</div>
</BaseLayout>
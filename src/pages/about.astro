---
import BaseLayout from "@/layouts/Base.astro";
import Icon from "@/components/Icon.astro";
import SocialLinks from "@/components/SocialLinks.astro";
import SubscribeBox from "@/components/SubscribeBox.astro";
import TimelineEntry from "@/components/TimelineEntry.astro";
import { getCollection, render } from "astro:content";
import { linkTypeIcons } from "@/data/icons";

const aboutEntries = await getCollection("other");
const about = aboutEntries.find((e) => e.id === "about");
const aboutRendered = about ? await render(about) : null;

const experience = await getCollection("experience");
const allExperience = experience.sort((a, b) => a.data.order - b.data.order);
const work = allExperience.filter((e) => e.data.type === "work");
const education = allExperience.filter((e) => e.data.type === "education");

const impact = await getCollection("impact");
const visibleImpact = impact
	.filter((i) => i.data.visible)
	.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="About" activePage="/about">
	<!-- Profile photo + bio -->
	<div class="mb-14 after:clear-both after:block">
		<img
			src="/images/art-profile-eeshan.jpeg"
			alt="Eeshan Srivastava"
			class="mr-7 mb-4 h-auto w-[min(240px,45vw)] float-left rounded-xl border border-line"
		/>
		{
			aboutRendered && (
				<div class="text-[16px] text-text-soft leading-relaxed [&>p]:mb-5 [&>p>a]:text-link [&>p>a]:transition-colors hover:[&>p>a]:text-link-2 [&>strong]:font-semibold [&>strong]:text-text">
					<aboutRendered.Content />
				</div>
			)
		}
	</div>

	<!-- Social links -->
	<SocialLinks class="mb-6" />

	<!-- Recognition & Leadership -->
	<section class="mt-16">
		<h2 class="kicker mb-6 border-b border-line pb-2">Recognition & Leadership</h2>
		<div class="flex flex-col">
			{visibleImpact.map((cat) => (
				<div class="border-b border-line py-5 last:border-b-0">
					<h3 class="mb-2.5 flex items-center gap-2 font-semibold">
						<Icon name={cat.data.icon} size={15} className="text-accent" />
						{cat.data.title}
					</h3>
					<ul class="space-y-1.5">
						{cat.data.items.map((item: { text: string; meta?: string; link?: string; linkType?: string }) => (
							<li class="text-text-soft">
								{item.link ? (
									<a href={item.link} class="inline-flex items-center gap-1.5 text-text transition-colors hover:text-link-2" target="_blank" rel="noopener noreferrer">
										{item.text}
									<Icon name={linkTypeIcons[item.linkType ?? "externalLink"] || "externalLink"} size={14} className="shrink-0" />
									</a>
								) : (
									<span class="text-text">{item.text}</span>
								)}
								{item.meta && (
									<span class="meta ml-2 text-[13px] text-text-faint">{item.meta}</span>
								)}
							</li>
						))}
					</ul>
				</div>
			))}
		</div>
	</section>

	<!-- Experience -->
	<section class="mt-16">
		<h2 class="kicker mb-6 border-b border-line pb-2">Experience</h2>
		<div class="flex flex-col">
			{work.map((entry) => (
				<TimelineEntry
					timespan={entry.data.timespan}
					title={entry.data.title}
					organization={entry.data.company}
					detail={entry.data.description}
					logo={entry.data.logo}
				/>
			))}
		</div>
	</section>

	<!-- Education -->
	<section class="mt-16">
		<h2 class="kicker mb-6 border-b border-line pb-2">Education</h2>
		<div class="flex flex-col">
			{education.map((entry) => (
				<TimelineEntry
					timespan={entry.data.timespan}
					title={entry.data.title}
					organization={entry.data.company}
					detail={entry.data.description}
					logo={entry.data.logo}
				/>
			))}
		</div>
	</section>

	<!-- Subscribe -->
	<div class="mt-16">
		<SubscribeBox feed="substack" />
	</div>
</BaseLayout>
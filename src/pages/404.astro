---
import BaseLayout from "@/layouts/Base.astro";
---

<BaseLayout title="404 Not Found">
	<div class="flex flex-col items-center justify-center py-24">
		<h1 class="text-[5rem] font-extrabold tracking-[-0.02em] text-accent leading-none">404</h1>
		<p class="mt-4 text-reading text-text-soft">Page Not Found</p>
		<a href="/" class="mt-6 text-meta text-accent transition-colors hover:text-accent-2">
			← Back home
		</a>
	</div>
</BaseLayout>